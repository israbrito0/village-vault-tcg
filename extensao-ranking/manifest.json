{
  "manifest_version": 3,
  "name": "Village & Vault - Assistente",
  "version": "2.13.0",
  "description": "Ranking das lives da Jamble e precos de cartas para o leilao do site.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.jamble.com/*",
    "https://www.villagetcg.com.br/*",
    "http://localhost:3100/*",
    "https://*.ligapokemon.com.br/*",
    "https://www.ligapokemon.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.jamble.com/*"
      ],
      "js": [
        "gemas.js",
        "content.js",
        "overlay.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.ligapokemon.com.br/*"
      ],
      "js": [
        "liga.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js",
        "painel.html",
        "painel.js",
        "gemas.js",
        "analises.js"
      ],
      "matches": [
        "https://*.jamble.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Village & Vault"
  }
}
